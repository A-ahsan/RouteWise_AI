# RouteWise AI — copy this to `.env` and fill in your keys (or set these as
# environment variables in your hosting dashboard). Never commit the real .env.

# --- OpenRouter (primary model provider) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Google AI Studio (automatic fallback) ---
GOOGLE_API_KEY=your-google-ai-studio-key
MODEL=gemma-4-31b-it

# --- Optional upgrades (app works fully without these) ---
ORS_API_KEY=
TOMTOM_API_KEY=

# Port is provided automatically by most hosts; local default is 3000.
PORT=3000
